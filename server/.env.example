# Server Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000

# Database - MongoDB
# For local development: mongodb://127.0.0.1:27017/portfolio
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Configuration (Optional)
# Leave empty to disable email notifications
# You need to generate an App Password for Gmail (not your regular password)
# https://support.google.com/accounts/answer/185833

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email recipients
CONTACT_EMAIL=your-email@gmail.com
CONTACT_RECEIVER=your-email@gmail.com

# Database credentials (for Docker only)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password

